{
  "$schema": "dsh-ui/api-contract@1",
  "version": 2,
  "input_style": "flat",
  "note": "自定契约，不复刻官方 {path,key} 信封；路径保持 /api/<method>。入参一律**平铺**：真宿主 handler 就是 json.NewDecoder(r.Body).Decode(&in) 直接解平铺结构。v2（2026-11-04）按真宿主当前实现重写：stream 段原来的 {t:ev,kind,topic} + gap 帧是**错的**，真形状是 {seq,type,data,time} 且服务端不发 gap；方法表 25 个；rc.2 追加 4 个（account 通知三件套 + agentTeams.setEnabled），共 29 个。",
  "envelope": {
    "request": {
      "style": "flat",
      "body": "{ \"id\": \"…\", \"tailMessages\": 2 }",
      "alias_rule": "同一字段的多个名字都收：sessionId 优先于 id，limit 优先于 tailMessages（对齐宿主 fillID / firstNonZero）",
      "legacy_wrapped": "{\"params\":{…}} 仅 cmd/mockd 兼容，真宿主只认平铺"
    },
    "response": {
      "result": "object"
    },
    "error": {
      "code": "string",
      "message": "string",
      "hint": "string",
      "retryable": "bool"
    }
  },
  "errors": {
    "not_found": "会话或路径不存在",
    "busy": "该会话有 turn 在跑，retryable=true",
    "invalid_arg": "参数不合法，hint 写清怎么改",
    "unsupported": "该方法本版本未实现",
    "internal": "宿主内部错误"
  },
  "stream": {
    "path": "/ws",
    "transport": "websocket",
    "client_frames": [
      {
        "t": "sub",
        "topic": "string",
        "sinceSeq": "int?",
        "journalEpoch": "int64?",
        "note": "两个水位要一起带；只带一个会让宿主补出一段错位数据"
      },
      {
        "t": "unsub",
        "topic": "string"
      },
      {
        "t": "ping",
        "note": "应用层心跳，不占用 WS 控制帧"
      }
    ],
    "server_frames": [
      {
        "seq": "int",
        "type": "string",
        "data": "object",
        "time": "int64",
        "note": "type 是 v4 原始事件名；**没有 topic 字段**——连接本身就是会话归属；也不是 {t:ev,kind}"
      }
    ],
    "control_frames": [
      {
        "type": "pong",
        "note": "无 seq、不入 journal"
      },
      {
        "type": "session/reset",
        "data": {
          "journalEpoch": "int64",
          "lastSeq": "int"
        },
        "note": "无 seq；收到就重建基线（清水位 → 重新 load → 按新基线 resub），不是 sinceSeq=0 重连"
      }
    ],
    "no_gap_frames": "服务端**不发** gap 帧：断号由客户端按 seq 连续性自己发现，再调 session.history 补洞",
    "types": [
      "turn/start",
      "turn/end",
      "turn/done",
      "turn/error",
      "user/message",
      "assistant/message",
      "tool/call",
      "tool/result",
      "system/message",
      "developer/message",
      "approval/request",
      "approval/timeout",
      "approval/cancel",
      "session/reset",
      "pong"
    ],
    "turn_end_shape": "{\"turn\":5,\"reason\":{\"kind\":\"completed|error|aborted|blocked|max-tokens|interrupted|forked\",\"error\":{\"message\":\"…\"},\"reason\":\"…\"}} —— 结局和失败原因都在 reason 里面"
  },
  "methods": {
    "session.list": {
      "batch": 1,
      "req": {},
      "resp": {
        "sessions": [
          {
            "id": "string",
            "title": "string",
            "cwd": "string",
            "updatedAt": "RFC3339"
          }
        ]
      },
      "req_note": "宿主不读 body"
    },
    "session.load": {
      "batch": 1,
      "req": {
        "sessionId": "string",
        "id": "string",
        "tailMessages": "int=200",
        "limit": "int=200"
      },
      "resp": {
        "messages": [
          "Message"
        ],
        "total": "int",
        "truncated": "bool",
        "model": "string?",
        "goal": "string?",
        "permission": "string?",
        "contentWidth": "int",
        "usageTotal": "UsageMsg?",
        "contextTokens": "int",
        "contextWindow": "int",
        "journalEpoch": "int64",
        "lastSeq": "int",
        "cwd": "string"
      },
      "req_note": "两个 id 名字、两个条数名字都收；sessionId 优先于 id，limit 优先于 tailMessages"
    },
    "session.history": {
      "batch": 1,
      "req": {
        "sessionId": "string",
        "id": "string",
        "sinceSeq": "int=0",
        "limit": "int=200",
        "journalEpoch": "int64=0"
      },
      "resp": {
        "frames": [
          "ServerFrame"
        ],
        "lastSeq": "int",
        "journalEpoch": "int64"
      },
      "req_note": "返回**原始帧**，不是抽过 text 的 messages；sinceSeq 是开区间（传 166 从 167 起）；journalEpoch 对不上回 409 stale_epoch"
    },
    "session.prompt": {
      "batch": 1,
      "req": {
        "sessionId": "string",
        "id": "string",
        "text": "string"
      },
      "resp": {
        "accepted": "bool",
        "turnId": "string"
      },
      "req_note": "宿主只读 text；回答走 WS，这个 HTTP 立刻返回"
    },
    "session.cancel": {
      "batch": 1,
      "req": {
        "sessionId": "string",
        "id": "string"
      },
      "resp": {
        "cancelled": "bool"
      },
      "req_note": "幂等：没有 turn 在跑也回 true"
    },
    "session.approve": {
      "batch": 2,
      "req": {
        "requestId": "string",
        "optionId": "string"
      },
      "resp": {
        "accepted": "bool",
        "optionId": "string"
      },
      "req_note": "optionId 只接受 allow_once / allow_always / reject_once（下划线）"
    },
    "session.create": {
      "batch": 1,
      "req": {
        "mode": "string=default"
      },
      "resp": {
        "sessionId": "string"
      },
      "req_note": "宿主**只解 mode**；cwd/title 客户端会发，宿主目前不读 → 别用它做'在某个目录新建会话'"
    },
    "session.delete": {
      "batch": 2,
      "req": {
        "sessionId": "string",
        "id": "string"
      },
      "resp": {
        "deleted": "bool"
      },
      "req_note": "两个名字都收（handlers_extra 的 fillID）；怕丢就两个都发"
    },
    "session.fork": {
      "batch": 2,
      "req": {
        "sessionId": "string",
        "id": "string",
        "title": "string?"
      },
      "resp": {
        "sessionId": "string"
      },
      "req_note": "**整份复制**，没有切点参数；空会话会失败（500 '源会话没有可继承的 surface'）；title 宿主目前不消费"
    },
    "session.compact": {
      "batch": 2,
      "req": {
        "sessionId": "string",
        "id": "string",
        "keep": "int=6"
      },
      "resp": {
        "compacted": "bool",
        "from": "int64",
        "to": "int64",
        "shadowed": "int",
        "summaryChars": "int"
      },
      "req_note": "keep<=0 用宿主默认 6；没内容可压时回 200 + compacted=false（**不是失败**）"
    },
    "session.setGoal": {
      "batch": 2,
      "req": {
        "id": "string",
        "goal": "string"
      },
      "resp": {
        "ok": "bool"
      },
      "req_note": "超过 maxGoalLen 会被宿主截断，不报错"
    },
    "session.setModel": {
      "batch": 2,
      "req": {
        "id": "string",
        "model": "string"
      },
      "resp": {
        "ok": "bool"
      },
      "req_note": "空串 = 清除覆盖"
    },
    "session.setPermission": {
      "batch": 2,
      "req": {
        "id": "string",
        "permission": "string"
      },
      "resp": {
        "ok": "bool"
      },
      "req_note": "白名单 deny/ask/allow/auto；空串 = 清除覆盖；非法值 400 并给白名单 hint"
    },
    "workspace.list": {
      "batch": 1,
      "req": {
        "path": "string?"
      },
      "resp": {
        "entries": [
          {
            "name": "string",
            "isDir": "bool",
            "size": "int64"
          }
        ]
      },
      "req_note": "path 为空 = 宿主进程工作目录；给了就列那个目录（只列顶层）"
    },
    "fs.read": {
      "batch": 1,
      "req": {
        "path": "string"
      },
      "resp": {
        "path": "string",
        "content": "string",
        "size": "int64"
      },
      "req_note": "宿主只解 path"
    },
    "fs.write": {
      "batch": 2,
      "req": {
        "path": "string",
        "content": "string"
      },
      "resp": {
        "written": "bool"
      },
      "req_note": "宿主只解 path/content；不建目录"
    },
    "config.get": {
      "batch": 1,
      "req": {},
      "resp": {
        "values": "object",
        "config": "object"
      },
      "req_note": "两个键都回同一份（历史原因）"
    },
    "config.set": {
      "batch": 2,
      "req": {
        "values": "object"
      },
      "resp": {
        "updated": "int"
      },
      "req_note": "values 是扁平 key→string；只覆盖给出的 key"
    },
    "models.list": {
      "batch": 1,
      "req": {},
      "resp": {
        "models": [
          {
            "id": "string",
            "ownedBy": "string"
          }
        ]
      },
      "req_note": "来自网关 /v1/models"
    },
    "jobs.list": {
      "batch": 1,
      "req": {},
      "resp": {
        "jobs": [
          {
            "id": "string",
            "command": "string",
            "done": "bool"
          }
        ]
      },
      "req_note": "宿主缓存的那份（子进程 @@JOBS@@ 推上来的），不是实时"
    },
    "jobs.output": {
      "batch": 2,
      "req": {
        "id": "string",
        "waitMs": "int=0"
      },
      "resp": {
        "…": "见 ../DSH-GO/internal/transport/handlers_jobs.go 的 JobOutput"
      },
      "req_note": "只在轮次进行中可用（每轮一个子进程，跑完就退）"
    },
    "schedule.list": {
      "batch": 1,
      "req": {},
      "resp": {
        "schedules": [
          {
            "id": "string",
            "title": "string",
            "kind": "string",
            "nextAt": "RFC3339"
          }
        ]
      }
    },
    "terminal.open": {
      "batch": 1,
      "req": {
        "cwd": "string?"
      },
      "resp": {
        "id": "string"
      },
      "req_note": "一次会话一个就够"
    },
    "terminal.input": {
      "batch": 1,
      "req": {
        "id": "string",
        "data": "string"
      },
      "resp": {
        "ok": "bool"
      },
      "req_note": "原样写，要换行自己带"
    },
    "terminal.output": {
      "batch": 1,
      "req": {
        "id": "string",
        "since": "int"
      },
      "resp": {
        "…": "见 ../DSH-GO/internal/transport/handlers_terminal.go 的 TerminalOutput"
      },
      "req_note": "增量"
    },
    "account.getNotifications": {
      "batch": 3,
      "req": {
        "client": {
          "version": "string",
          "locale": "string",
          "timezoneOffsetSeconds": 0
        }
      },
      "resp": {
        "batch": null
      },
      "req_note": "rc.2（官方 dsh-deepseek-account）。client=AccountClientMetadata 三个字段必填，缺了宿主回 invalid_arg。resp.batch 是 **null 或批次**：null=未登录/授权在查询中变了，不是空批次。"
    },
    "account.getNotificationContent": {
      "batch": 3,
      "req": {
        "id": "string",
        "client": {
          "version": "string",
          "locale": "string",
          "timezoneOffsetSeconds": 0
        }
      },
      "resp": {
        "content": null
      },
      "req_note": "rc.2。resp.content 是 null 或一条 AccountNotification（id/createdAt/displayUntil/title/body/actions[]/data?）。"
    },
    "account.reportNotificationEvent": {
      "batch": 3,
      "req": {
        "id": "string",
        "event": "displayed|cta_clicked|dismissed",
        "client": {
          "version": "string",
          "locale": "string",
          "timezoneOffsetSeconds": 0
        }
      },
      "resp": true,
      "req_note": "rc.2。结果是**裸 boolean**（不是对象）：true=平台接受了这次上报。event 是闭集，未知值宿主回 invalid_arg。"
    },
    "agentTeams.setEnabled": {
      "batch": 3,
      "req": {
        "agentId": "string",
        "enabled": true
      },
      "resp": {},
      "req_note": "rc.2（官方 dsh-agent-team）。agentId 必须是**树根会话**；非根回 403 team_lead_required。官方结果 z.void()，本仓 wire 用空对象 {}。"
    }
  },
  "counts": {
    "total": 29,
    "batch1": 15,
    "batch2": 10,
    "batch3": 4
  }
}
