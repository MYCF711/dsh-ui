{
  "$schema": "dsh-ui/api-contract@1",
  "version": 1,
  "input_style": "flat",
  "note": "自定契约，不复刻官方 {path,key} 信封；路径保持 /api/<method> 便于将来加兼容映射。入参一律平铺：真宿主 handler 就是 json.NewDecoder(r.Body).Decode(&in) 直接解平铺结构（../DSH-GO/internal/transport/server.go）。{\"params\":{…}} 只有 cmd/mockd 为历史脚本继续收，新代码不许发——套一层会让参数全部解成零值，症状是 list 正常、load 404、prompt 子进程参数为空",
  "envelope": {
    "request": {
      "style": "flat",
      "body": "{ \"id\": \"…\", \"tailMessages\": 2 }",
      "alias_rule": "同一字段的多个名字都收：sessionId 优先于 id，limit 优先于 tailMessages（对齐宿主 fillID / firstNonZero）",
      "legacy_wrapped": "{\"params\":{…}} 仅 cmd/mockd 兼容，真宿主只认平铺"
    },
    "response": {
      "result": "object"
    },
    "error": {
      "code": "string",
      "message": "string",
      "hint": "string",
      "retryable": "bool"
    }
  },
  "errors": {
    "not_found": "会话或路径不存在",
    "busy": "该会话有 turn 在跑，retryable=true",
    "invalid_arg": "参数不合法，hint 写清怎么改",
    "unsupported": "该方法本版本未实现",
    "internal": "宿主内部错误"
  },
  "stream": {
    "path": "/api/mux",
    "transport": "websocket",
    "client_frames": [
      {
        "t": "sub",
        "topic": "string",
        "sinceSeq": "int?"
      },
      {
        "t": "unsub",
        "topic": "string"
      },
      {
        "t": "ping"
      }
    ],
    "server_frames": [
      {
        "t": "ev",
        "topic": "string",
        "seq": "int",
        "kind": "string",
        "data": "object"
      },
      {
        "t": "gap",
        "topic": "string",
        "fromSeq": "int",
        "toSeq": "int",
        "reason": "需要重新拉 history"
      },
      {
        "t": "pong"
      }
    ],
    "topics": {
      "session:<id>": "该会话的 v4 事件（62 种原始词汇，不另造）",
      "turn:<id>": "助手流式增量：text-delta / reasoning-delta / tool-call-delta，带 revision/index"
    },
    "continuity": "seq 连续；断号发 gap 帧，客户端按 session.history 补洞，不整体刷新"
  },
  "methods": {
    "session.list": {
      "batch": 1,
      "req": {},
      "req_note": "宿主忽略 body（handler 不读 r.Body）；客户端传 {} 即可",
      "resp": {
        "sessions": [
          {
            "id": "string",
            "title": "string",
            "cwd": "string",
            "updatedAt": "RFC3339",
            "mode": "string"
          }
        ],
        "next": "string?"
      }
    },
    "session.create": {
      "batch": 1,
      "req": {
        "mode": "string=default"
      },
      "req_note": "宿主只解 mode；cwd/title 客户端会发但目前没有任何一侧读（尚未实现）",
      "resp": {
        "id": "string",
        "createdAt": "RFC3339",
        "mode": "string"
      }
    },
    "session.load": {
      "batch": 1,
      "req": {
        "sessionId": "string",
        "id": "string",
        "tailMessages": "int=200",
        "limit": "int=200"
      },
      "req_note": "两个 id 名字、两个条数名字都收；sessionId 优先于 id，limit 优先于 tailMessages（target：打开会话含尾页）",
      "resp": {
        "id": "string",
        "title": "string",
        "cwd": "string",
        "mode": "string",
        "messages": [
          "Message"
        ],
        "truncated": "bool",
        "total": "int"
      }
    },
    "session.history": {
      "batch": 1,
      "req": {
        "sessionId": "string",
        "id": "string",
        "sinceSeq": "int?",
        "limit": "int=200"
      },
      "req_note": "断号后按 sinceSeq 补洞；beforeSeq 是旧快照里的猜名，两边都没有实现",
      "resp": {
        "messages": [
          "Message"
        ],
        "nextBefore": "int?"
      }
    },
    "session.prompt": {
      "batch": 1,
      "req": {
        "sessionId": "string",
        "id": "string",
        "text": "string"
      },
      "req_note": "宿主只读 text；attachments 不在契约里（旧快照的猜名，未实现）",
      "resp": {
        "turnId": "string",
        "accepted": "bool"
      }
    },
    "session.cancel": {
      "batch": 1,
      "req": {
        "sessionId": "string",
        "id": "string"
      },
      "resp": {
        "cancelled": "bool"
      }
    },
    "session.delete": {
      "batch": 2,
      "req": {
        "sessionId": "string"
      },
      "req_note": "宿主只认 sessionId（没有 id 别名）；mockd 仍是 501",
      "resp": {
        "deleted": "bool"
      }
    },
    "session.fork": {
      "batch": 2,
      "req": {
        "sessionId": "string",
        "title": "string?"
      },
      "req_note": "宿主只认 sessionId/title；fromSeq 是旧快照里的猜名，未实现",
      "resp": {
        "id": "string",
        "parentSession": "string"
      }
    },
    "workspace.list": {
      "batch": 1,
      "req": {},
      "resp": {
        "roots": [
          {
            "path": "string",
            "name": "string",
            "isGit": "bool"
          }
        ]
      }
    },
    "fs.read": {
      "batch": 2,
      "req": {
        "path": "string"
      },
      "req_note": "宿主只解 path；maxBytes 未实现（大小上限在宿主侧，不由协议层定）",
      "resp": {
        "path": "string",
        "content": "string",
        "truncated": "bool",
        "size": "int"
      }
    },
    "fs.write": {
      "batch": 2,
      "req": {
        "path": "string",
        "content": "string"
      },
      "req_note": "宿主只解 path/content；createDirs 未实现（协议层不建目录）",
      "resp": {
        "path": "string",
        "bytes": "int"
      }
    },
    "config.get": {
      "batch": 1,
      "req": {},
      "req_note": "宿主不读 body（整份配置原样返回）；keys 过滤尚未实现",
      "resp": {
        "values": "object"
      }
    },
    "config.set": {
      "batch": 2,
      "req": {
        "values": "object"
      },
      "req_note": "values 是扁平的 key → string 表；只覆盖给出的 key",
      "resp": {
        "ok": "bool"
      }
    },
    "session.approve": {
      "batch": 2,
      "req": {
        "requestId": "string",
        "optionId": "string"
      },
      "resp": {
        "accepted": "bool",
        "optionId": "string"
      }
    }
  },
  "counts": {
    "total": 14,
    "batch1": 8,
    "batch2": 6
  }
}
